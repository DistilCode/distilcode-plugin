{
  "name": "distilcode",
  "version": "1.2.1",
  "description": "DistilCode for Codex: persistent per-repo codebase memory, rtk-compacted shell output, and ponytail/caveman modes shared with the DistilCode CLI and the Claude Code plugin",
  "author": {
    "name": "vineeth898"
  },
  "homepage": "https://github.com/DistilCode/distilcode-plugin",
  "repository": "https://github.com/DistilCode/distilcode-plugin",
  "keywords": [
    "distilcode",
    "distil",
    "token-saver",
    "save-costs",
    "context-reducer",
    "codebase-memory",
    "rtk",
    "token-efficiency",
    "mcp"
  ],
  "skills": "./skills/",
  "mcpServers": "./.codex-mcp.json",
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"${PLUGIN_ROOT}/scripts/hooks.js\" SessionStart --codex",
              "timeout": 10
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"${PLUGIN_ROOT}/scripts/hooks.js\" UserPromptSubmit --codex",
              "timeout": 10
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "^Bash$",
          "hooks": [
            {
              "type": "command",
              "command": "node \"${PLUGIN_ROOT}/scripts/hooks.js\" PreToolUse --codex",
              "timeout": 10
            }
          ]
        }
      ],
      "SubagentStart": [
        {
          "matcher": "^explorer$",
          "hooks": [
            {
              "type": "command",
              "command": "node \"${PLUGIN_ROOT}/scripts/hooks.js\" SubagentStart --codex",
              "timeout": 10
            }
          ]
        }
      ]
    }
  },
  "interface": {
    "displayName": "DistilCode",
    "shortDescription": "Codebase memory, compact shell output, ponytail/caveman modes",
    "developerName": "vineeth898",
    "category": "Developer Tools",
    "capabilities": [
      "Read",
      "Write"
    ],
    "defaultPrompt": [
      "Enable codebase memory for this repo",
      "caveman on"
    ]
  }
}
